{
  "name": "ngx-toast-alerts",
  "version": "3.0.1",
  "description": "Angular toast alerts library",
  "author": "Babatunde Lamidi (GhostOfWinterfell)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/babatundelmd/ngx-toast-alerts.git"
  },
  "keywords": [
    "angular",
    "toast",
    "alerts",
    "notifications"
  ],
  "dependencies": {
    "tslib": "^2.3.0"
  },
  "scripts": {
    "ng": "ng",
    "start": "npm run build && ng serve test-ngx-toast-alerts",
    "build": "ng build ngx-toast-alerts",
    "build:demo": "npm run build && ng build test-ngx-toast-alerts",
    "watch": "ng build ngx-toast-alerts --watch --configuration development",
    "test": "npm run build && ng test ngx-toast-alerts",
    "test:demo": "npm run build && ng test test-ngx-toast-alerts",
    "e2e": "playwright test",
    "e2e:headed": "playwright test --headed",
    "e2e:debug": "playwright test --debug",
    "e2e:ui": "playwright test --ui",
    "e2e:report": "playwright show-report",
    "lint:tokens": "node scripts/check-style-tokens.mjs",
    "lint:versions": "node scripts/check-versions.mjs",
    "release:notes": "node scripts/release-notes.mjs",
    "typecheck": "npm run build && tsc --noEmit -p tsconfig.json",
    "serve:test": "npm start",
    "prepack:lib": "ng build ngx-toast-alerts --configuration production && cp LICENSE CHANGELOG.md dist/ngx-toast-alerts/",
    "pack:lib": "npm run prepack:lib && cd dist/ngx-toast-alerts && npm pack --dry-run",
    "verify:package": "node scripts/verify-package.mjs",
    "publish:lib": "npm run prepack:lib && cd dist/ngx-toast-alerts && npm publish"
  },
  "private": false,
  "engines": {
    "node": "^22.22.3 || ^24.15.0 || >=26.0.0"
  },
  "devDependencies": {
    "@angular/build": "^22.1.6",
    "@angular/cli": "^22.1.6",
    "@angular/common": "^22.1.4",
    "@angular/compiler": "^22.1.4",
    "@angular/compiler-cli": "^22.1.4",
    "@angular/core": "^22.1.4",
    "@angular/platform-browser": "^22.1.4",
    "@angular/platform-server": "^22.1.4",
    "@angular/router": "^22.1.4",
    "@angular/ssr": "^22.1.6",
    "@playwright/test": "^1.56.1",
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.0",
    "express": "^5.1.0",
    "istanbul-lib-instrument": "^6.0.3",
    "jsdom": "^30.0.1",
    "ng-packagr": "^22.1.1",
    "rxjs": "~7.8.0",
    "typescript": "~6.0.3",
    "vitest": "^4.0.8"
  }
}

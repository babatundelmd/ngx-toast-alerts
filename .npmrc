# Do not auto-install optional peer dependencies.
#
# @angular/build declares karma, jasmine, less, tailwindcss and others as
# optional peers, and npm installs them by default. This project tests with
# Vitest only, so karma and its transitive tree (socket.io, lodash, engine.io)
# were being installed and audited for nothing.
#
# The trade-off is that any peer we genuinely need must be an explicit
# devDependency — @angular/router, for example, is a required peer of
# @angular/ssr. That is the point: it makes the real dependencies visible.
omit=peer

# Fail `npm install` outright on an unsupported Node rather than warning and
# then dying mid-build with "The Angular CLI requires a minimum Node.js
# version". The supported range lives in the root package.json `engines`:
# ^22.22.3 || ^24.15.0 || >=26.0.0
engine-strict=true
